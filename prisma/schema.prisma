generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js required ────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  favorites     Favorite[]
  printLogs     PrintLog[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── App-specific ─────────────────────────────────────────────────────────────

// 施設種別
// nursery=保育園 kindergarten=幼稚園 combined=認定こども園
// afterschool=学童  individual=個人  other=その他
model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityType   String?
  facilityName   String?
  prefecture     String?
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  /** ユーザー定義のグループ名（null = 未分類） */
  groupName  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, materialId])
  @@index([userId, groupName])
}

/**
 * 本番(Vercel)で data.ts を直接書き換えられないため、
 * 管理画面からの imageStatus / illustNotes の変更を DB に保存して
 * 読み出し時にマージ適用する。
 */
model MaterialOverride {
  materialId  String   @id
  imageStatus String?
  illustNotes String?
  updatedAt   DateTime @updatedAt
}

model PrintLog {
  id         String   @id @default(cuid())
  userId     String?
  materialId String
  isColor    Boolean?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model SearchRequest {
  id        String   @id @default(cuid())
  query     String
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([query])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String?
  email     String
  category  String   // 'request' | 'bug' | 'copyright' | 'other'
  subject   String?
  body      String   @db.Text
  ip        String?
  userAgent String?
  /** 管理: 'new' | 'read' | 'replied' | 'spam' */
  status    String   @default("new")
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

// ── 「今日のいちまい」投稿 ──────────────────────────────────────────────────
// Twitter風の編集UIから入稿する記事。複数画像 + 本文 + 関連素材リンク。
// publishedAt の値で状態を表す:
//   NULL          → 下書き（非公開）
//   未来日時      → 投稿予約
//   過去 or 現在  → 公開中
model Post {
  id          String   @id @default(cuid())
  /** 任意のタイトル。未指定なら本文先頭から自動抽出 */
  title       String?
  /** 本文（Markdownライト・改行保持） */
  body        String   @db.Text
  /** 公開・予約日時。null = 下書き */
  publishedAt DateTime?
  /** リンクする素材ID配列（data.ts の materials[].id） */
  materialIds String[]
  images      PostImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([createdAt])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  /** Supabase Storage の公開URL */
  url       String
  /** 表示順（小さい順） */
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId, order])
}
