generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js required ────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  favorites     Favorite[]
  printLogs     PrintLog[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── App-specific ─────────────────────────────────────────────────────────────

// 施設種別
// nursery=保育園 kindergarten=幼稚園 combined=認定こども園
// afterschool=学童  individual=個人  other=その他
model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityType   String?
  facilityName   String?
  prefecture     String?
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  /** ユーザー定義のグループ名（null = 未分類） */
  groupName  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, materialId])
  @@index([userId, groupName])
}

/**
 * 本番(Vercel)で data.ts を直接書き換えられないため、
 * 管理画面からの imageStatus / illustNotes の変更を DB に保存して
 * 読み出し時にマージ適用する。
 */
model MaterialOverride {
  materialId  String   @id
  imageStatus String?
  illustNotes String?
  updatedAt   DateTime @updatedAt
}

model PrintLog {
  id         String   @id @default(cuid())
  userId     String?
  materialId String
  isColor    Boolean?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model SearchRequest {
  id        String   @id @default(cuid())
  query     String
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([query])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String?
  email     String
  category  String   // 'request' | 'bug' | 'copyright' | 'other'
  subject   String?
  body      String   @db.Text
  ip        String?
  userAgent String?
  /** 管理: 'new' | 'read' | 'replied' | 'spam' */
  status    String   @default("new")
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

// ── 実体験ギャラリー（実際に塗ってみた作品） ────────────────────────────────
// 個別素材ページの scaled content 脱却の主軸。1作品 = 1レコード。
// アップロードは /admin/works から、表示は /materials/[id] の作品セクションで。
model GalleryWork {
  id         String   @id @default(cuid())
  /** 塗った対象の material.id (data.ts) */
  materialId String
  /** Supabase Storage の完成写真URL */
  photoUrl   String
  /** タイムラプス動画URL（任意） */
  videoUrl   String?
  /** 自由記述の年齢ラベル。例: "2歳10ヶ月", "5歳", "編集部試し塗り" */
  childAge   String
  /** かかった時間（分・任意） */
  duration   Int?
  /** 使った画材（任意・カンマ区切り or 文字列） */
  tools      String?
  /** 体験コメント（必須） */
  comment    String   @db.Text
  /** 公開フラグ。一時非公開時に false */
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([materialId])
  @@index([createdAt])
}
